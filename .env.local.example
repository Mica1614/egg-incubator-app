# ─────────────────────────────────────────────────────────────────────────────
# .env.local — Egg Incubator App — Email Configuration
#
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Gmail address used as the sender
GMAIL_USER=yourapp@gmail.com

# Gmail App Password (16-character, no spaces)
# How to generate: Google Account → Security → 2-Step Verification → App Passwords
# Choose app: "Mail", device: "Other (Custom name)" → Generate
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
